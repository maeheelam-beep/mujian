# 本机 Web 预览时需要设置访问密码（桌面端会自动生成，无需配置）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：用环境变量预置点播源 / 直播源
# DEFAULT_SOURCES=[{"key":"example","name":"示例源","url":"https://example.com/api.php/provide/vod"}]
# DEFAULT_LIVE_SOURCES=[{"name":"示例直播","url":"https://example.com/live.m3u"}]

# 可选：影视榜单推荐源地址，默认 https://60s.viki.moe
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false
